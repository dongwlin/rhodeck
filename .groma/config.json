{
  "scanners": [
    {
      "id": "c",
      "source": "@groma/scanner-c@0.1.1",
      "include": [
        "**/*.c",
        "**/*.h"
      ]
    },
    {
      "id": "go",
      "source": "@groma/scanner-go@0.2.3",
      "include": [
        "**/*.go",
        "**/go.mod"
      ],
      "exclude": [
        "vendor/"
      ]
    }
  ],
  "workSources": [
    {
      "id": "backlog",
      "version": "1.55.3"
    }
  ],
  "exclude": [
    "/tools/",
    "**/testdata/",
    "**/*_test.go",
    "/packages/maa-go/internal/ffitest/"
  ]
}
